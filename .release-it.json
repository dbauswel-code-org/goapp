{
  "git": {
    "requireCleanWorkingDir": true,
    "tagName": "v${version}",
    "commitMessage": "chore(release): v${version}",
    "push": true
  },
  "github": {
    "release": true,
    "tokenRef": "GITHUB_TOKEN"
  },
	"ci": true,
  "hooks": {
    "before:init": "go test -v ./...",
    "after:bump": "echo Releasing version ${version}",
    "after:release": "echo Released ${version}!"
  }
}
